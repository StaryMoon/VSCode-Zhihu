doctype html
html
  head
    include css.pug
  body
    div(class='header')
      include header.pug
    div(class='container')
      each answer in answers
        div(class='answer-block')
          div(class='author')
            span(class='avatar-span')
              a(href=`https://www.zhihu.com/people/${answer.author.url_token}`)
                img(class='avatar-img', src=`${answer.author.avatar_url}`)
            div(class='profile')
              div(class='author-name') #{answer.author.name}
              div(class='author-headline') #{answer.author.headline}
          div(class='content') !{answer.content}
          div(class='actions')
            span(class='voteup-group')
              button(class='voteup-btn', type='button', onclick=`answerUpvote(${answer.id})`) ▲ 赞同 #{answer.voteup_count || 0}
              button(class='voteup-more-btn', type='button') ▼
            button(class='action-btn', type='button') 反对
            button(class='action-btn', type='button') 评论 #{answer.comment_count || 0}
            button(class='action-btn', type='button', data-command='collect', data-item-id=`${answer.id}`, data-item-type='answer') 收藏 #{answer.favlists_count || 0}
            button(class='action-btn', type='button', data-command='share') 分享
    script
      include js/global.js
