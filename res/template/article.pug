doctype html
html
  head
    include css.pug
    title= title
  body
    div(class='header')
      include header.pug
    div(class='container')
      div(class='article-toolbar')
        button(class='action-btn article-edit-btn', type='button', data-command='editArticle', data-item-id=`${article.id}`, data-item-type='article', title='在 Markdown 编辑器中修改这篇文章') ✎ 编辑文章
      div(class='author')
        span(class='avatar-span')
          a(href=`https://www.zhihu.com/people/${article.author.url_token}`)
            img(class='avatar-img', src=`${article.author.avatar_url}`)
        div(class='profile')
          div(class='author-name') #{article.author.name}
          div(class='author-headline') #{article.author.headline}
      div(class='content') !{article.content}
      div(class='actions')
        span(class='voteup-group')
          button(class='voteup-btn', type='button', onclick=`articleUpvote(${article.id})`) ▲ 赞同 #{article.voteup_count || 0}
          button(class='voteup-more-btn', type='button') ▼
        button(class='action-btn', type='button') 评论 #{article.comment_count || 0}
        button(class='action-btn', type='button', data-command='collect', data-item-id=`${article.id}`, data-item-type='article') 收藏 #{article.favlists_count || 0}
        button(class='action-btn', type='button', data-command='share') 分享
    script
      include js/global.js
